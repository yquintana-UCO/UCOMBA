# --- Supabase (Project Settings -> API). Leave blank to run with sample data. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI guide: pick one provider ---
AI_PROVIDER=anthropic          # anthropic | openai | openrouter
AI_MODEL=                      # optional override, e.g. claude-sonnet-5 or anthropic/claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
