# Copy to .env and fill in. .env is git-ignored; never commit real keys.
UCOMBA=your-claude-api-key-here

# Optional: federal jobs from USAJOBS. Free key at https://developer.usajobs.gov
# (the email must be the one the key was registered with).
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# "Ask the Scout" agent (update_employer_list / find_open_roles)
# Tavily finds each company's job board and its postings: https://tavily.com
TAVILY_API_KEY=
# Firecrawl reads each posting page into clean text: https://firecrawl.dev
FIRECRAWL_API_KEY=
