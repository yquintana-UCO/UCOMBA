# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Email via Resend (https://resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Job Scout <scout@yourdomain.com>"

# Who results may be emailed to: comma-separated addresses and/or @domains.
EMAIL_ALLOWLIST=you@uco.edu,@uco.edu
